# Copy this file to .env and fill it in.

# Password for the /admin page (required)
ADMIN_PASSWORD=change-me

# Any long random string; keeps admin logins valid across restarts
SESSION_SECRET=replace-with-a-long-random-string

# Your time zone (used for "today", sign-in times and emails)
TIME_ZONE=America/Los_Angeles

# Shown in email subjects and signatures
APP_NAME=Weight Room

PORT=3000
# DATABASE_FILE=./data/weight-room.db

# Set to true once the app is served over https
SECURE_COOKIES=false

# ---- Email (needed for "Notify Coaches") ----
# Gmail example: use an App Password, not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Weight Room <you@gmail.com>"
