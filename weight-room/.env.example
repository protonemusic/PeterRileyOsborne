# Copy this file to .env and fill it in.

# The first admin account. Only used when the app starts with no users;
# after that, manage accounts on the admin page (Users tab).
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.org
ADMIN_PASSWORD=pick-a-strong-password

# Your time zone (used for "today", sign-in times and emails)
TIME_ZONE=America/Los_Angeles

# Shown in email subjects and signatures
APP_NAME=Weight Room

PORT=3000
# Optional: the public address used in workout QR codes, e.g. https://weight-room.onrender.com
# PUBLIC_URL=
# DATABASE_FILE=./data/weight-room.db

# Set both to true when hosted behind https (Render, Railway, etc.)
SECURE_COOKIES=false
TRUST_PROXY=false

# ---- Email (needed for "Notify Coaches") ----
# Gmail example: use an App Password, not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Weight Room <you@gmail.com>"
